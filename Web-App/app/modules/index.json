[
  {
    "id": "gps",
    "name": "GPS",
    "displayName": "GPS",
    "version": "1.0.0",
    "type": "module",
    "description": "Neutral GPS tracking module. Provides geolocation access, position events and track storage.",
    "entry": "index.js",
    "globalName": "GpsModule",
    "permissions": [
      {
        "key": "gps.view",
        "description": "Allows a user to see the GPS module in the workspace.",
        "defaultRoles": [
          "admin",
          "developer",
          "user"
        ]
      },
      {
        "key": "gps.use",
        "description": "Allows a user to request positions and start GPS tracking.",
        "defaultRoles": [
          "admin",
          "developer",
          "user"
        ]
      },
      {
        "key": "gps.manage",
        "description": "Allows a user to manage GPS-related module settings.",
        "defaultRoles": [
          "admin",
          "developer"
        ]
      },
      {
        "key": "gps.admin",
        "description": "Allows a user to administer the GPS module lifecycle and role assignments.",
        "defaultRoles": [
          "admin",
          "developer"
        ]
      }
    ],
    "access": {
      "visibilityPermissions": [
        "gps.view"
      ],
      "usagePermissions": [
        "gps.use"
      ],
      "managementPermissions": [
        "gps.manage"
      ],
      "adminPermissions": [
        "gps.admin"
      ]
    },
    "capabilities": [
      "gps",
      "geolocation"
    ],
    "dependencies": [],
    "compatibility": {
      "core": ">=1.0.0 <2.0.0",
      "api": 1,
      "php": ">=8.0.0"
    },
    "server": {
      "entry": "Server/php/modules/gps/module.php",
      "services": [
        "module.gps.status"
      ],
      "routes": [
        {
          "method": "GET",
          "path": "status",
          "service": "module.gps.status",
          "action": "status",
          "permission": "gps.view",
          "csrf": false
        }
      ]
    },
    "standalone": {
      "entry": "index.html",
      "label": "GPS standalone test",
      "description": "Loads the GPS module with lightweight local shims for UI and browser geolocation checks without the full application shell.",
      "requires": {
        "server": false,
        "database": false,
        "auth": false
      }
    },
    "database": {
      "tables": [],
      "migrations": []
    },
    "limits": [],
    "uninstall": {
      "dataPolicy": "retain"
    },
    "admin": {
      "title": "GPS settings",
      "description": "Controls for browser geolocation behaviour and local GPS data handling.",
      "settings": [
        {
          "key": "enableHighAccuracy",
          "path": "moduleSettings.gps.enableHighAccuracy",
          "label": "Enable high accuracy",
          "type": "boolean",
          "defaultValue": true,
          "description": "Ask the browser for the most precise available position."
        },
        {
          "key": "timeoutMs",
          "path": "moduleSettings.gps.timeoutMs",
          "label": "Location timeout (ms)",
          "type": "number",
          "defaultValue": 10000,
          "min": 1000,
          "step": 500,
          "description": "Maximum time the module waits for a geolocation response."
        },
        {
          "key": "maximumAgeMs",
          "path": "moduleSettings.gps.maximumAgeMs",
          "label": "Cached position age (ms)",
          "type": "number",
          "defaultValue": 0,
          "min": 0,
          "step": 1000,
          "description": "How old a cached GPS position may be before the browser must refresh it."
        },
        {
          "key": "persistLocationHistory",
          "path": "moduleSettings.gps.persistLocationHistory",
          "label": "Persist location history",
          "type": "boolean",
          "defaultValue": true,
          "description": "Store GPS positions in the local framework storage for later reuse."
        }
      ]
    },
    "appId": null
  },
  {
    "id": "reference-notes",
    "name": "Reference Notes",
    "displayName": "Reference Notes",
    "version": "1.0.0",
    "type": "module",
    "description": "Minimal independent reference module for server routes, migrations, permissions and limits.",
    "entry": "index.js",
    "globalName": "ReferenceNotesModule",
    "permissions": [
      {
        "key": "reference-notes.view",
        "description": "Allows a user to view reference notes.",
        "defaultRoles": [
          "admin",
          "developer",
          "user"
        ]
      },
      {
        "key": "reference-notes.use",
        "description": "Allows a user to create and delete own reference notes.",
        "defaultRoles": [
          "admin",
          "developer",
          "user"
        ]
      },
      {
        "key": "reference-notes.admin",
        "description": "Allows a user to administer the reference module.",
        "defaultRoles": [
          "admin",
          "developer"
        ]
      }
    ],
    "access": {
      "visibilityPermissions": [
        "reference-notes.view"
      ],
      "usagePermissions": [
        "reference-notes.use"
      ],
      "managementPermissions": [
        "reference-notes.admin"
      ],
      "adminPermissions": [
        "reference-notes.admin"
      ]
    },
    "capabilities": [
      "notes",
      "server-storage",
      "reference-contract"
    ],
    "dependencies": [],
    "compatibility": {
      "core": ">=1.0.0 <2.0.0",
      "api": 1,
      "php": ">=8.0.0"
    },
    "server": {
      "entry": "Server/php/modules/reference-notes/module.php",
      "services": [
        "module.reference-notes.notes"
      ],
      "routes": [
        {
          "method": "GET",
          "path": "items",
          "service": "module.reference-notes.notes",
          "action": "list",
          "permission": "reference-notes.view",
          "csrf": false
        },
        {
          "method": "POST",
          "path": "items",
          "service": "module.reference-notes.notes",
          "action": "create",
          "permission": "reference-notes.use",
          "csrf": true,
          "limit": {
            "key": "reference-notes.items",
            "cost": 1,
            "usageAction": "count"
          }
        },
        {
          "method": "DELETE",
          "path": "items",
          "service": "module.reference-notes.notes",
          "action": "delete",
          "permission": "reference-notes.use",
          "csrf": true
        }
      ]
    },
    "database": {
      "tables": [
        {
          "name": "reference_notes_items",
          "destroyOnUninstall": false,
          "description": "User-owned records for the independent module contract reference."
        }
      ],
      "migrations": [
        {
          "key": "2026_09_03_0001_create_notes",
          "version": "1.0.0"
        }
      ]
    },
    "limits": [
      {
        "key": "reference-notes.items",
        "default": 0,
        "roles": {
          "viewer": 0,
          "user": 100,
          "developer": 1000,
          "admin": null
        }
      }
    ],
    "uninstall": {
      "dataPolicy": "retain"
    },
    "appId": null
  }
]
