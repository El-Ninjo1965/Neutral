# Copy this file to a host-local .env and set the empty values before installation.
# Keep .env outside public delivery and never commit host-specific secrets.

# Public application settings
APP_ID=neutral-app
APP_NAME=Neutral Platform
APP_ENV=production
APP_DEBUG=false
NEUTRAL_BASE_PATH=

# Database: DB_URL is an alternative to the individual DB_* settings.
DB_TYPE=mysql
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_URL=

# Initial administrator: required for the one-time installation.
CORE_BOOTSTRAP_USERNAME=
CORE_BOOTSTRAP_PASSWORD=

# Session and login settings
AUTH_SESSION_COOKIE_NAME=neutral_session
AUTH_SESSION_TTL_MS=43200000
AUTH_LOGIN_IDENTIFIER_LIMIT=5
AUTH_LOGIN_IP_LIMIT=20
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOGIN_LOCK_SECONDS=900
SESSION_SECRET=

# Optional authorization and provider secrets stay host-local and empty here.
AUTH_TOKEN=
ADMIN_ACCESS_TOKEN=
NEUTRAL_ADMIN_TOKEN=
PROVIDER_SECRET=

# Backup encryption requires a host-local key with at least 32 characters.
NEUTRAL_BACKUP_KEY=

# Leave recovery disabled unless a short, authorized recovery window is required.
NEUTRAL_SETUP_RECOVERY_ENABLED=false
NEUTRAL_SETUP_RECOVERY_TOKEN=
