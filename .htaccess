Options -Indexes
DirectoryIndex Web-App/public/index.html

RewriteEngine On

# Enforce HTTPS permanently for every public request. HTTP must never serve the
# application: geolocation and other secure-context APIs depend on it. Path and
# query string are preserved; HTTPS requests are not redirected (no loop).
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Never expose configuration, server internals, runtime state, or repository data.
RewriteRule (^|/)\. - [F,L]
RewriteRule ^Server/(php|runtime)(/|$) - [F,L,NC]

# Preserve existing public files and directories in any per-directory install location.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Preserve the repository's two-component layout while exposing stable public URLs.
RewriteRule ^core/(.*)$ Web-App/core/$1 [L]
RewriteRule ^style\.css$ Web-App/public/style.css [L]
RewriteRule ^user-app\.js$ Web-App/public/user-app.js [L]
RewriteRule ^user-module-access\.js$ Web-App/public/user-module-access.js [L]
RewriteRule ^public-path\.js$ Web-App/public/public-path.js [L]
RewriteRule ^api(?:/.*)?$ Server/public/api/index.php [END,QSA]
RewriteRule ^admin\.php$ Server/public/admin.php [L,QSA]
RewriteRule ^setup\.php$ Server/public/setup.php [L,QSA]

# Application routes fall back to the static shell relative to this install directory.
RewriteRule ^ Web-App/public/index.html [L]

# Long-lived browser caching for the static application assets. The deployment
# manifest (manifest.json, SHA256SUMS) and HTML/API responses stay uncached so
# new revisions are picked up; JS/CSS assets are reused across warm starts.
<IfModule mod_headers.c>
  <FilesMatch "\.(?:js|css)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>
