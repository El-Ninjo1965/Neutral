# Framework - Git Ignore

# Operating System
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Environment / Secrets
.env
.env.*
!.env.example
!.env.ftp.deploy.example

# Dependencies
node_modules/

# Package Manager
.npm/
*.tgz
.npmrc.local

# Development Caches
.cache/
.vite/
.eslintcache
.stylelintcache
.nyc_output/
coverage/
*.lcov
*.tsbuildinfo

# Local test artifacts
test-results/

# Build Output
dist/
build/
out/

# Temporary Files
tmp/
temp/
*.tmp
*.temp

# Terminal Working File
terminal.md

# Editor / IDE
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo

# Local Development Data
*.local

# Legacy/local runtime setup state must not be committed.
server/runtime/
.deploy-staging/

# Local runtime configuration generated by development services must not be committed.
config/*.json

# Local Node/PHP test runtime data may contain sessions, CSRF tokens and password hashes.
Server/config/*.json

# Runtime Database Files
# Schema, migrations and seed files remain tracked.
# Only SQLite runtime sidecar files are ignored.
*.sqlite-shm
*.sqlite-wal
*.db-shm
*.db-wal

# Runtime / Process Files
*.pid
*.pid.lock
*.seed

# Generated deployment/runtime state
.neutral-deploy-manifest.json
Server/node/runtime/
Server/runtime/
.worktrees/
.superpowers/
