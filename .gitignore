# Framework - Git Ignore

# Operating System
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Environment / Secrets
.env
.env.*
!.env.example
!.env.ftp.deploy.example

# Dependencies
node_modules/

# Package Manager
.npm/
*.tgz
.npmrc.local

# Development Caches
.cache/
.vite/
.eslintcache
.stylelintcache
.nyc_output/
coverage/
*.lcov
*.tsbuildinfo

# Local test artifacts
test-results/

# Build Output
dist/
build/
out/

# Temporary Files
tmp/
temp/
*.tmp
*.temp

# Terminal Working File
terminal.md

# Editor / IDE
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo

# Local Development Data
*.local

# Runtime setup state
# Full repository sync is explicitly enabled for this project; runtime state is intentionally included in the working repository.
server/runtime/
.deploy-staging/

# Runtime configuration files (persisted by persistence-service)
# Full repository sync is explicitly enabled for this project; runtime config files remain part of the repository state.
config/*.json

# Runtime Database Files
# Schema, migrations and seed files remain tracked.
# Only SQLite runtime sidecar files are ignored.
*.sqlite-shm
*.sqlite-wal
*.db-shm
*.db-wal

# Runtime / Process Files
*.pid
*.pid.lock
*.seed

# Generated deployment/runtime state
.neutral-deploy-manifest.json
Server/node/runtime/
Server/runtime/
.worktrees/
